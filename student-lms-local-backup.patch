+
+/** Filter discoverable rows for the paid course catalog (both source types). */
+export function filterPaidCatalogDiscoverableItems(
+  items: PaidCourseCatalogDiscoverableItem[],
+): PaidCourseCatalogDiscoverableItem[] {
+  return items.filter((item) => {
+    if (item.catalog_kind !== 'master_course') return false;
+    if (!isPaidCatalogPremiumItem(item, { isEntitled: item.is_enrolled })) return false;
+    return isPaidCatalogEligible(item, { isEntitled: item.is_enrolled });
+  });
+}
+
+type LandingVisibilityRow = {
+  source_id: string;
+  is_published: boolean;
+  is_visible: boolean;
+};
+
+/** Apply paid_course_landing_metadata visibility for non-entitled catalog rows. */
+export async function applyPaidCatalogLandingVisibility(
+  items: PaidCourseCatalogDiscoverableItem[],
+): Promise<PaidCourseCatalogDiscoverableItem[]> {
+  const eligible = filterPaidCatalogDiscoverableItems(items);
+  if (eligible.length === 0) return [];
+
+  const needsMetaCheck = eligible.filter((item) => !item.is_enrolled);
+  if (needsMetaCheck.length === 0) return eligible;
+
+  const { createAdminClient } = await import('@/lib/supabase/admin');
+  const sb = createAdminClient();
+  const courseIds = [...new Set(needsMetaCheck.map((item) => item.id))];
+
+  const { data: metaRows } = await sb
+    .from('paid_course_landing_metadata')
+    .select('source_id, is_published, is_visible')
+    .in('source_id', courseIds);
+
+  const metaByCourseId = new Map(
+    ((metaRows ?? []) as LandingVisibilityRow[]).map((row) => [row.source_id, row]),
+  );
+
+  return eligible.filter((item) => {
+    if (item.is_enrolled) return true;
+    const meta = metaByCourseId.get(item.id);
+    const hasPaidCatalogFlag =
+      item.paid_source_type === 'paid_course_builder' || item.show_as_paid_course;
+    return isPaidLandingPubliclyVisible(meta, { hasPaidCatalogFlag });
+  });
+}
