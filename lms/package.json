{
  "name": "lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3002": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --config vitest.config.mjs",
    "test:ui:run": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.config.mjs",
    "test:ui:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --watch --config vitest.config.mjs",
    "test:ui:check": "node scripts/check-vitest-ui-setup.mjs",
    "test:e2e:ui:ready": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-playwright-ui.ps1",
    "email:test": "tsx scripts/test-email-adapter.ts",
    "payment:retry-side-effects": "tsx --require ./scripts/tsx-server-only-stub.cjs scripts/retry-payment-side-effects.ts",
    "payment:retry-note-emails": "tsx --require ./scripts/tsx-server-only-stub.cjs scripts/retry-note-payment-emails.ts",
    "payment:retry-mentorship-emails": "tsx --require ./scripts/tsx-server-only-stub.cjs scripts/retry-mentorship-emails.ts",
    "email:preview-transactional": "tsx --require ./scripts/tsx-server-only-stub.cjs scripts/preview-transactional-emails.ts",
    "db:streak": "node scripts/run-streak-migration.mjs",
    "db:profile": "node scripts/run-profile-migration.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.98.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.14.2",
    "lenis": "^1.3.25",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.0",
    "motion": "^12.4.7",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "postcss-load-config": "^6.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
